# MongoDB Atlas — Connect → Drivers → copy URI, replace <password>
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/algeria-marketiva?retryWrites=true&w=majority
MONGODB_DB=algeria-marketiva

# Admin login (server-side only)
ADMIN_USERNAME=YounesMarketiva
ADMIN_PASSWORD=change-me

# Long random string for JWT session cookies
JWT_SECRET=generate-a-long-random-string
